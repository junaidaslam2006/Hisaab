# Copy this file to .env and fill in the values. Never commit your real .env.

# --- Required -----------------------------------------------------------------
# A free Gemini API key from https://aistudio.google.com/apikey (no billing needed).
GEMINI_API_KEY=

# --- Optional: server ---------------------------------------------------------
PORT=3000
# Public HTTPS address (for example a Cloudflare tunnel) so login links work on phones.
PUBLIC_URL=
# Where the database, WhatsApp sessions and media are kept (default: ./data).
HISAAB_DATA_DIR=
# Messages each shop may send per day (default 300).
DAILY_MESSAGE_LIMIT=300

# --- Optional: voice replies --------------------------------------------------
# Order of text-to-speech engines for the Urdu voice reply.
TTS_ORDER=uplift,edge,gemini
# Uplift AI key for a Pakistani Urdu voice (leave empty to use the Edge voice).
UPLIFT_API_KEY=
UPLIFT_VOICE=
# Microsoft Edge neural voice, for example ur-PK-AsadNeural or ur-PK-UzmaNeural.
EDGE_VOICE=ur-PK-AsadNeural

# --- Optional: AI models (defaults are in server/config.js) ---------------------
PARSE_MODELS=
PARSE_FALLBACK_MODELS=
LIVE_PARSE_MODELS=
LIVE_TEXT_MODELS=
LIVE_MODEL=
LIVE_CALL_MODEL=
LIVE_VOICE=

# --- Optional: backups ----------------------------------------------------------
# A folder for automatic database backups (for example a USB drive), and a 64-hex-character key to encrypt them.
BACKUP_DIR=
BACKUP_KEY=

# --- Optional: tools ------------------------------------------------------------
# Full paths to ffmpeg and ffprobe if they are not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Optional: web app (set, then run `npm run build` again) ---------------------
# Contact address shown on the Privacy and Terms pages.
VITE_SUPPORT_EMAIL=
